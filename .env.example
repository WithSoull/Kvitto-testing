# Local run against `docker compose up -d db`
DATABASE_URL=postgresql+asyncpg://kvitto:kvitto@localhost:5432/kvitto
# Bank webhook HMAC secret (X-Signature); the same default as in docker-compose.yml
WEBHOOK_SECRET=dev-webhook-secret
# Used by the test suite; defaults to this value when unset
TEST_DATABASE_URL=postgresql+asyncpg://kvitto:kvitto@localhost:5432/kvitto_test
